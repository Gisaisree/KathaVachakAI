# Backend. Copy to backend/.env and fill in.
PORT=6000
MONGO_URI=
JWT_SECRET=

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# External services the backend proxies to.
STORY_SERVICE_URL=
READOUT_SERVICE_URL=

# Optional: upstream timeout in milliseconds (default 30000).
# UPSTREAM_TIMEOUT_MS=30000
